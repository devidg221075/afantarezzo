---
import '../styles/main.css';
const { title, description = "Associazione Farmacisti Non Titolari della provincia di Arezzo", current = '' } = Astro.props;
const full = title ? `${title} | A.FA.N.T. Arezzo` : 'A.FA.N.T. Arezzo | Associazione Farmacisti Non Titolari di Arezzo';
const seoOrigin = (import.meta.env.PUBLIC_SITE_ORIGIN || 'https://www.afantarezzo.it').replace(/\/$/, '');
const isProductionSite = seoOrigin === 'https://www.afantarezzo.it';
const is404 = Astro.url.pathname === '/404' || Astro.url.pathname === '/404.html';
const canonical = new URL(Astro.url.pathname, seoOrigin).href;
const menu = [
  ['/', 'Home'], ['/chi-siamo/', 'Chi siamo'], ['/iscrizione/', 'Iscrizione'],
  ['/notizie/', 'Notizie'], ['/documenti/', 'Documenti'], ['/ccnl/', 'CCNL'], ['/lavoro/', 'Lavoro'], ['/contatti/', 'Contatti'],
];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  {!isProductionSite || is404 ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
  <meta name="color-scheme" content="light" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#contenuto">Vai al contenuto</a>
  <div class="band">
    <div class="rib" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="A.FA.N.T. Arezzo — Home">
        <!-- Il viewBox inquadra il marchio senza modificare l'SVG originale. -->
        <svg class="brand-logo" viewBox="138 198 562 96" width="562" height="96" role="img" aria-label="AFANT Arezzo — Associazione Farmacisti Non Titolari Arezzo">
          <image href="/brand/afant.svg" width="841.89" height="595.28" />
        </svg>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="menu">Menu</button>
      <nav class="nav" id="menu" aria-label="Principale">
        <ul>
          {menu.map(([href, label]) => (
            <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      </div>
    </header>
    <slot name="hero" />
  </div>
  <main id="contenuto">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div>
        <h2>A.FA.N.T. Arezzo</h2>
        <p>Associazione Farmacisti Non Titolari della provincia di Arezzo</p>
        <p class="small">P.IVA / C.F. IT92058170512</p>
      </div>
      <div>
        <h2>Contatti</h2>
        <p>Via Newton 48, 52100 Arezzo (AR)</p>
        <p><a href="mailto:info@afantarezzo.it">info@afantarezzo.it</a></p>
        <p>Tel. <a href="tel:+393703613108">370 3613108</a></p>
      </div>
      <div>
        <h2>Per gli iscritti</h2>
        <p><a href="/iscrizione/">Come iscriversi</a></p>
        <p><a href="/documenti/">Documenti e moduli</a></p>
        <p><a href="/notizie/">Tutte le notizie</a></p>
        <p><a href="/link-utili/">Link utili</a></p>
        <p><a href="/presentazione-sinasfa/">Presentazione Sinasfa</a></p>
        <p><a href="/privacy/">Privacy e cookie</a></p>
      </div>
    </div>
  </footer>
  <aside class="privacy-notice" data-privacy-notice hidden aria-label="Informazioni sulla privacy">
    <p>Informazioni su privacy e cookie disponibili nella <a href="/privacy/">pagina dedicata</a>.</p>
    <button type="button" data-privacy-close aria-label="Chiudi avviso privacy">Chiudi</button>
  </aside>
  <script is:inline>
    (function(){var notice=document.querySelector('[data-privacy-notice]');if(!notice)return;
      try{if(sessionStorage.getItem('afant_avviso_privacy')==='chiuso')return;}catch(e){}
      notice.hidden=false;notice.querySelector('[data-privacy-close]').addEventListener('click',function(){notice.hidden=true;try{sessionStorage.setItem('afant_avviso_privacy','chiuso')}catch(e){}});})();
  </script>
  <script is:inline>
    (function(){var b=document.querySelector('.nav-toggle'),n=document.getElementById('menu');
    b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o)});})();
  </script>
</body>
</html>
