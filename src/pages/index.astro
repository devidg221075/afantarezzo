---
import Base from '../layouts/Base.astro';
import { news, formatDate, excerpt } from '../lib/news.js';
import eventi from '../data/eventi.json';
const oggi = new Date().toISOString().slice(0, 10);
const prossimo = eventi.filter((e) => e.data >= oggi).sort((a, b) => a.data.localeCompare(b.data))[0];
const ultima = news[0];
const primoAnno = news.reduce((m, n) => (n.date < m ? n.date : m), news[0].date).slice(0, 4);
// Se l'HERO mostra l'ultima comunicazione, la griglia parte dalla successiva per non ripeterla.
const ultime = prossimo ? news.slice(0, 3) : news.slice(1, 4);
---
<Base current="/">
  <section class="hero" slot="hero" aria-labelledby="titolo-hero">
    <div class="wrap">
      <div>
        <h1 id="titolo-hero">A.FA.N.T. Arezzo<br /><span>Farmacisti Non Titolari</span></h1>
        <p class="lead">Dal maggio 2008 Afant-Arezzo raggruppa i farmacisti non titolari della provincia di Arezzo, con un proprio statuto e un Consiglio Direttivo.</p>
        <div class="actions">
          <a class="btn" href="/iscrizione/">Iscriviti</a>
          <a class="btn sec" href="/chi-siamo/">Chi siamo</a>
        </div>
        <div class="chips">
          <span>Dal 2008</span>
          <span>Quota 15 € l'anno</span>
          <span>{news.length} comunicazioni dal {primoAnno}</span>
        </div>
      </div>
      <aside class="glass" aria-label={prossimo ? 'Prossimo evento' : 'Ultima comunicazione'}>
        {prossimo ? (
          <>
            <span class="tag">Prossimo evento</span>
            <h2>{prossimo.titolo}</h2>
            <p class="date">{formatDate(prossimo.data)}{prossimo.ora ? `, ore ${prossimo.ora}` : ''}{prossimo.luogo ? ` · ${prossimo.luogo}` : ''}</p>
            {prossimo.descrizione && <p>{prossimo.descrizione}</p>}
            {prossimo.link && <p><a href={prossimo.link}>Dettagli →</a></p>}
          </>
        ) : (
          <>
            <span class="tag">Ultima comunicazione</span>
            <h2><a href={`/notizie/${ultima.slug}/`}>{ultima.title}</a></h2>
            <p class="date">{formatDate(ultima.date)}</p>
            <p>{excerpt(ultima.raw, 32)}</p>
            <p><a href={`/notizie/${ultima.slug}/`}>Leggi tutto →</a></p>
          </>
        )}
      </aside>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="ultime">
    <h2 id="ultime">Ultime comunicazioni</h2>
    <div class="grid">
      {ultime.map((n) => (
        <article class="card">
          <span class="tag">{n.categoria}</span>
          <h3><a href={`/notizie/${n.slug}/`}>{n.title}</a></h3>
          <p class="date">{formatDate(n.date)}</p>
          <p>{excerpt(n.raw)}</p>
        </article>
      ))}
    </div>
    <p class="more"><a class="btn" href="/notizie/">Tutte le notizie</a></p>
  </section>

  <section class="section wrap" aria-labelledby="accessi">
    <h2 id="accessi">Per gli iscritti</h2>
    <div class="grid quick">
      <a class="card" href="/iscrizione/"><strong>Iscrizione</strong>Quota annuale e come pagarla.</a>
      <a class="card" href="/ccnl/"><strong>CCNL</strong>I contratti collettivi, con quelli in vigore in evidenza.</a>
      <a class="card" href="/documenti/"><strong>Documenti e moduli</strong>Statuto, codice deontologico, deleghe, circolari.</a>
      <a class="card" href="/contatti/"><strong>Contatti</strong>Scrivici per informazioni e consulenza.</a>
    </div>
  </section>
</Base>
