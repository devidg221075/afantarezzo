---
import Base from '../layouts/Base.astro';
import { news, appuntamenti, allegatiDi, formatDate, excerpt } from '../lib/news.js';
import eventi from '../data/eventi.json';
import HeroBackground from '../components/HeroBackground.astro';
import hero from '../data/hero.json';
const MESI = ['gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre'];
const oggi = new Date().toISOString().slice(0, 10);
const prossimo = eventi.filter((e) => e.data >= oggi).sort((a, b) => a.data.localeCompare(b.data))[0];
const ultima = news[0];
const primoAnno = news.reduce((m, n) => (n.date < m ? n.date : m), news[0].date).slice(0, 4);
// Se il riquadro in evidenza mostra l'ultima comunicazione, la griglia parte dalla successiva per non ripeterla.
// Le convocazioni hanno la loro sezione "Appuntamenti AFANT": qui restano le altre comunicazioni.
const altre = news.filter((n) => n.categoria !== 'Appuntamenti');
const ultime = prossimo ? altre.slice(0, 3) : altre.filter((n) => n !== ultima).slice(0, 3);
// Riquadro in evidenza: prossimo evento se c'è, altrimenti l'ultima comunicazione.
const iso = prossimo ? prossimo.data : ultima.date;
const [anno, mese, giorno] = iso.split('-').map(Number);
const vetrina = prossimo
  ? { tag: 'Prossimo evento', titolo: prossimo.titolo, link: prossimo.link ?? null,
      testo: [prossimo.ora ? `Ore ${prossimo.ora}` : '', prossimo.luogo ?? '', prossimo.descrizione ?? ''].filter(Boolean).join(' · '), cta: 'Dettagli →' }
  : { tag: 'Ultima comunicazione', titolo: ultima.title, link: `/notizie/${ultima.slug}/`, testo: excerpt(ultima.raw, 32), cta: 'Leggi tutto →' };
---
<Base current="/">
  <section class="hero" slot="hero" aria-labelledby="titolo-hero">
    <HeroBackground slides={hero.slides} intervallo={hero.intervallo} />
    <div class="wrap hc">
      <span class="eyebrow">Arezzo · dal 2008</span>
      <h1 id="titolo-hero">A.FA.N.T. Arezzo<br /><span>Farmacisti Non Titolari</span></h1>
      <p class="lead">Dal maggio 2008 Afant-Arezzo raggruppa i farmacisti non titolari della provincia di Arezzo, con un proprio statuto e un Consiglio Direttivo.</p>
      <div class="actions">
        <a class="btn" href="/iscrizione/">Iscriviti</a>
        <a class="btn sec" href="/chi-siamo/">Chi siamo</a>
      </div>
    </div>
  </section>

  <div class="wrap float">
    <aside class:list={['fnews', { 'fnews-evento': prossimo?.immagine }]} aria-label={vetrina.tag}>
      <div>
        <div class="dn">{giorno}</div>
        <div class="dm">{MESI[mese - 1]} {anno}</div>
      </div>
      <div>
        <span class="tag">{vetrina.tag}</span>
        <h2>{vetrina.link ? <a href={vetrina.link}>{vetrina.titolo}</a> : vetrina.titolo}</h2>
        <p>{vetrina.testo}</p>
      </div>
      {prossimo?.immagine && <a class="fnews-poster" href={vetrina.link} aria-label={`Apri la notizia: ${vetrina.titolo}`}><img src={prossimo.immagine} alt={`Locandina: ${vetrina.titolo}`} width="160" height="226" /></a>}
      {vetrina.link && <a class="btn" href={vetrina.link}>{vetrina.cta}</a>}
    </aside>
    <div class="stats3">
      <div><b>2008</b><span>anno di fondazione</span></div>
      <div><b>15 €</b><span>quota annuale di iscrizione</span></div>
      <div><b>{news.length}</b><span>comunicazioni dal {primoAnno}</span></div>
    </div>
  </div>

  <section class="section wrap" aria-labelledby="avviso-obesita">
    <h2 id="avviso-obesita">Avviso: serata per gli iscritti</h2>
    <div class="avviso-locandina">
      <img src="/locandine/obesita-diabete-focus-nuovi-farmaci-2026.jpg" alt="Locandina: Obesità e diabete, focus sui nuovi farmaci. Incontro con la Dott.ssa Alessia Scatena e l'infermiera Serena Vannacci, 25 novembre 2026, ore 21:30, Ordine dei Farmacisti della provincia di Arezzo." width="1080" height="1350" loading="lazy" />
      <div>
        <h3>Obesità e diabete - Focus sui nuovi farmaci</h3>
        <p>25 novembre 2026, ore 21:30, presso l'Ordine dei Farmacisti della provincia di Arezzo: serata di approfondimento professionale per gli iscritti ad Afant Arezzo.</p>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="appuntamenti">
    <h2 id="appuntamenti">Appuntamenti AFANT</h2>
    <div class="grid">
      {appuntamenti.slice(0, 3).map((n) => (
        <article class="card">
          <span class="tag">Appuntamenti</span>
          <h3><a href={`/notizie/${n.slug}/`}>{n.title}</a></h3>
          <p class="date">{formatDate(n.date)}</p>
          <p>{excerpt(n.raw)}</p>
          <p class="file-links">
            <a href={`/notizie/${n.slug}/`}>Leggi</a>
            {allegatiDi(n.slug).map((f) => <a href={f.file} download>Scarica il file</a>)}
          </p>
        </article>
      ))}
    </div>
    <p class="more"><a class="btn" href="/appuntamenti/">Tutti gli appuntamenti</a></p>
  </section>

  <section class="section wrap" aria-labelledby="ultime">
    <h2 id="ultime">Ultime comunicazioni</h2>
    <div class="grid">
      {ultime.map((n) => (
        <article class="card">
          <span class="tag">{n.categoria}</span>
          <h3><a href={`/notizie/${n.slug}/`}>{n.title}</a></h3>
          <p class="date">{formatDate(n.date)}</p>
          <p>{excerpt(n.raw)}</p>
        </article>
      ))}
    </div>
    <p class="more"><a class="btn" href="/notizie/">Tutte le notizie</a></p>
  </section>

  <section class="section wrap" aria-labelledby="accessi">
    <h2 id="accessi">Per gli iscritti</h2>
    <div class="grid quick">
      <a class="card" href="/iscrizione/"><strong>Iscrizione</strong>Quota annuale e come pagarla.</a>
      <a class="card" href="/ccnl/"><strong>CCNL</strong>I contratti collettivi, con quelli in vigore in evidenza.</a>
      <a class="card" href="/documenti/"><strong>Documenti e moduli</strong>Statuto, codice deontologico, deleghe, circolari.</a>
      <a class="card" href="/contatti/"><strong>Contatti</strong>Scrivici per informazioni e consulenza.</a>
    </div>
  </section>
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var sl = document.querySelector('[data-hero-slideshow]');
      if (sl) {
        var bar = document.createElement('div');
        bar.className = 'hero-progress';
        bar.setAttribute('aria-hidden', 'true');
        bar.style.setProperty('--hp', (Math.max(5000, Number(sl.dataset.intervallo) || 8000) / 1000) + 's');
        sl.appendChild(bar);
        var restart = function () { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; };
        sl.querySelectorAll('.hero-photo').forEach(function (p) {
          new MutationObserver(function () { if (p.classList.contains('is-active')) restart(); }).observe(p, { attributes: true, attributeFilter: ['class'] });
        });
        var pb = sl.querySelector('[data-hero-pause]');
        if (pb) new MutationObserver(function () { bar.style.animationPlayState = pb.textContent.trim() === 'Riprendi' ? 'paused' : 'running'; }).observe(pb, { childList: true, characterData: true, subtree: true });
      }
      document.querySelectorAll('.stats3 b').forEach(function (b) {
        var t = b.textContent, m = t.match(/\d+/);
        if (!m) return;
        var end = +m[0], pre = t.slice(0, m.index), post = t.slice(m.index + m[0].length), t0 = null;
        b.setAttribute('aria-label', t);
        b.textContent = pre + '0' + post;
        var run = function (ts) { t0 = t0 || ts; var k = Math.min(1, (ts - t0) / 1500), e = 1 - Math.pow(1 - k, 3); b.textContent = pre + Math.round(end * e) + post; if (k < 1) requestAnimationFrame(run); };
        setTimeout(function () { requestAnimationFrame(run); }, 900);
      });
      var els = document.querySelectorAll('main section.section h2, main section.section .card, main section.section .more');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.15 });
        els.forEach(function (el, i) { el.classList.add('rv'); el.style.transitionDelay = ((i % 4) * 90) + 'ms'; io.observe(el); });
      }
    })();
  </script>
</Base>
