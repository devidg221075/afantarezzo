---
import Base from '../layouts/Base.astro';
import * as chi from '../content/pagine/chi-siamo.md';
const PREVIEW = import.meta.env.PUBLIC_PREVIEW === '1';
const Content = chi.Content;
---
<Base title="La nostra storia" current="/chi-siamo/" description="La storia di A.FA.N.T. Arezzo, associazione dei farmacisti non titolari della provincia di Arezzo.">
  <div class="wrap page">
    <p class="crumbs"><a href="/">Home</a> / Chi siamo</p>
    <h1>La nostra storia</h1>
    {PREVIEW && <p class="preview-note">Testo originale mantenuto, come scelto dal cliente. Da aggiornare: la frase "Dopo l'ultima assemblea elettiva (Maggio 2023)" è superata. Dalla newsletter di giugno 2026 risulta che alle elezioni del 25 maggio 2026 (triennio 2026-2029) è stato riconfermato il consiglio uscente, quindi i nomi restano validi ma la data va corretta.</p>}
    <div class="prose"><Content /></div>
    <p class="actions" style="margin-top:1.5rem"><a class="btn" href="/iscrizione/">Come iscriversi</a><a class="btn sec" href="/documenti/">Statuto e codice deontologico</a></p>
  </div>
</Base>
