---
import Base from '../layouts/Base.astro';
import { appuntamenti, allegatiDi, formatDate } from '../lib/news.js';
const anni = [...new Set(appuntamenti.map((n) => n.date.slice(0, 4)))].sort((a, b) => b.localeCompare(a));
---
<Base title="Appuntamenti" current="/notizie/" description="Convocazioni di assemblee e incontri di A.FA.N.T. Arezzo, con i file allegati.">
  <div class="wrap page">
    <p class="crumbs"><a href="/">Home</a> / <a href="/notizie/">Notizie</a> / Appuntamenti</p>
    <h1>Appuntamenti AFANT</h1>
    <p>Le convocazioni di assemblee e incontri: {appuntamenti.length} dal {anni[anni.length - 1]} a oggi. Dove disponibile, è possibile scaricare il file della convocazione.</p>
    {anni.map((a) => (
      <section class="anno" aria-labelledby={`a-${a}`}>
        <h2 class="year" id={`a-${a}`}>{a}</h2>
        <ul class="list">
          {appuntamenti.filter((n) => n.date.startsWith(a)).map((n) => (
            <li>
              <span class="date">{formatDate(n.date)}</span>
              <span>
                <a href={`/notizie/${n.slug}/`}>{n.title}</a>
                {allegatiDi(n.slug).map((f) => <small><a href={f.file} download>{f.titolo}</a></small>)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
