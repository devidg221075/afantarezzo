---
import Base from '../layouts/Base.astro';
import associazione from '../data/associazione.json';
const PREVIEW = import.meta.env.PUBLIC_PREVIEW === '1';
const anno = new Date().getFullYear();
const dati = ['Nome e cognome','Codice fiscale','Se eri già iscritto lo scorso anno (sì/no)','Email e PEC','Telefono e indirizzo','Luogo e data di nascita','Ordine di appartenenza e luogo di lavoro','Ricevuta del bonifico'];
const mail = `mailto:info@afantarezzo.it?subject=${encodeURIComponent('Iscrizione Afant ' + anno)}&body=${encodeURIComponent('Dati richiesti per l\'iscrizione:\n' + dati.map((d) => '- ' + d + ':').join('\n'))}`;
---
<Base title="Iscrizione" current="/iscrizione/" description="Come iscriversi ad A.FA.N.T. Arezzo: quota annuale di 15 euro.">
  <div class="wrap page">
    <p class="crumbs"><a href="/">Home</a> / Iscrizione</p>
    <h1>Iscrizione ad Afant Arezzo</h1>
    {PREVIEW && <p class="preview-note">Da decidere con il cliente: (1) modulo online al posto di questa pagina di istruzioni (serve un servizio per i form e un'informativa sui dati raccolti, tra cui il codice fiscale); (2) conferma della quota per l'anno prossimo. L'IBAN è quello attuale della pagina Iscrizione del sito vecchio; si aggiorna solo in src/data/associazione.json. Nel sito vecchio il modulo era un componente del tema e non è recuperabile.</p>}
    <div class="prose">
      <h2>Modalità di iscrizione</h2>
      <p>AFANT AREZZO richiede una quota di iscrizione annuale di <strong>15,00 €</strong>.</p>
      <p>Per accelerare la procedura è possibile inviare la copia del bonifico a <a href="mailto:info@afantarezzo.it">info@afantarezzo.it</a>. A questo punto verrà considerata l'iscrizione completata.</p>
      <h2>Come si effettua il pagamento</h2>
      <p>La quota di 15,00 € può essere versata tramite bonifico su conto corrente bancario intestato a <strong>{associazione.intestatario}</strong>.</p>
      <p>Causale: <strong>iscrizione Afant {anno}</strong></p>
      <p>IBAN: <strong>{associazione.iban}</strong></p>
      <h2>Dati da comunicare</h2>
      <ul>{dati.map((d) => <li>{d}</li>)}</ul>
      <p><a class="btn" href={mail}>Scrivi per iscriverti</a></p>
    </div>
  </div>
</Base>
